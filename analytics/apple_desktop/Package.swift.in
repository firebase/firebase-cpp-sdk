// Template rendered by build_apple_analytics_sdk.py. It pulls the
// FirebaseAnalytics product (and its transitive dependencies) for macOS so
// they can be archived and embedded into macOS desktop binaries.
//
// @FIREBASE_IOS_SDK_VERSION@ is taken from ios_spm/Package.swift so macOS
// desktop and iOS always use the same Firebase Apple SDK release.

import PackageDescription

let package = Package(
    name: "FirebaseCppAppleAnalyticsDeps",
    platforms: [
        .macOS("@MACOS_DEPLOYMENT_TARGET@")
    ],
    products: [
        .library(
            name: "FirebaseCppAppleAnalyticsDeps",
            type: .static,
            targets: ["FirebaseCppAppleAnalyticsDeps"]
        ),
    ],
    dependencies: [
        .package(url: "https://github.com/firebase/firebase-ios-sdk.git",
                 exact: "@FIREBASE_IOS_SDK_VERSION@"),
    ],
    targets: [
        .target(
            name: "FirebaseCppAppleAnalyticsDeps",
            dependencies: [
                .product(name: "FirebaseAnalytics", package: "firebase-ios-sdk"),
            ],
            path: "Sources/FirebaseCppAppleAnalyticsDeps"
        ),
    ]
)
